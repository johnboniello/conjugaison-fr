<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/progressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Aucun verbe actif. Va dans « Choisir les verbes »."
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bodyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/promptView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:gravity="center"
                android:padding="16dp"
                android:text=""
                android:textColor="#1A1A1A"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="2dp"
                android:text="Choisis la bonne forme :"
                android:textColor="#1A1A1A"
                android:textSize="15sp" />

            <Button android:id="@+id/opt0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingTop="15dp" android:paddingBottom="15dp"
                android:textAllCaps="false" android:textSize="20sp" android:text="" />
            <Button android:id="@+id/opt1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingTop="15dp" android:paddingBottom="15dp"
                android:textAllCaps="false" android:textSize="20sp" android:text="" />
            <Button android:id="@+id/opt2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingTop="15dp" android:paddingBottom="15dp"
                android:textAllCaps="false" android:textSize="20sp" android:text="" />
            <Button android:id="@+id/opt3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingTop="15dp" android:paddingBottom="15dp"
                android:textAllCaps="false" android:textSize="20sp" android:text="" />

            <TextView
                android:id="@+id/feedbackView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="➡️  Question suivante"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
