<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ConjugaisonFR" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/violet</item>
        <item name="colorPrimaryDark">@color/violet_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/violet</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="materialButtonStyle">@style/Widget.Conj.Button</item>
    </style>

    <!-- Default button: soft-rounded, solid violet. -->
    <style name="Widget.Conj.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/violet</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Conj.Button.M1">
        <item name="backgroundTint">@color/m1</item>
        <item name="android:textColor">@color/m1_on</item>
        <item name="rippleColor">#3334176B</item>
    </style>

    <style name="Widget.Conj.Button.M2">
        <item name="backgroundTint">@color/m2</item>
        <item name="android:textColor">@color/m2_on</item>
        <item name="rippleColor">#3323306B</item>
    </style>

    <style name="Widget.Conj.Button.M3">
        <item name="backgroundTint">@color/m3</item>
        <item name="android:textColor">@color/m3_on</item>
        <item name="rippleColor">#336A1550</item>
    </style>

    <!-- Pale utility button (levels, keyboard, verb tools) with a hairline outline. -->
    <style name="Widget.Conj.Button.Pale" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/pale_stroke</item>
        <item name="backgroundTint">@color/pale</item>
        <item name="android:textColor">@color/pale_on</item>
        <item name="rippleColor">#224527A0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
